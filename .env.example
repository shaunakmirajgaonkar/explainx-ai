# ExplainX AI — environment variable template
# Copy this file to `.env` and adjust as needed. All values are optional;
# the platform runs fully local with sensible defaults if unset.

# --- Backend ---
# Host/port the FastAPI backend binds to (default: 127.0.0.1:8000)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# SQLite database path (default: backend/explainx.db)
DATABASE_URL=sqlite:///./explainx.db

# --- Dashboard ---
# URL the Streamlit dashboard uses to reach the backend API
API_BASE=http://127.0.0.1:8000

# Port the Streamlit dashboard runs on (default: 8501)
DASHBOARD_PORT=8501
